# Public site URL (canonical, OG, JSON-LD) — production: https://nikookiadb.com
NEXT_PUBLIC_SITE_URL=https://nikookiadb.com

# Contact (override defaults in lib/constants.ts)
NEXT_PUBLIC_PHONE_TEL=+917039011696
NEXT_PUBLIC_PHONE_DISPLAY=+91 70390 11696
NEXT_PUBLIC_WHATSAPP_NUMBER=917039011696

# Brochure PDF URL — shown after successful form submit (opens in new tab)
NEXT_PUBLIC_BROCHURE_URL=https://your-cdn.com/nikoo-homes-9-brochure.pdf

# Site visit — paste the iframe `src` from your scheduler (must be embeddable).
#
# Cal.com: Event type → ⋮ → Embed → “Inline embed” → copy URL from the iframe, e.g.
#   https://cal.com/your-username/30min?embed=true
#   or https://app.cal.com/your-username/30min/embed
# Calendly: Share → Add to Website → Inline widget → copy embed URL.
# Google Appointment Schedules: use the published booking page URL if it allows iframe embedding.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-username/30min?embed=true

# Google Analytics 4
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads (gtag config + conversion — use full send_to in code if needed)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=AW-XXXXXXXXX/YYYYYYYYYY

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# Server-only: Google Apps Script Web App URL (Deploy → Web app → copy URL)
# Script source: scripts/google-sheets-leads/Code.gs
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: long random string — must match Script property WEBHOOK_SECRET (not the deployment ID)
GOOGLE_SHEETS_WEBHOOK_SECRET=